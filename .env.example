# ============================================
# RUNBRASIL - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env.local e preencha os valores

# ============================================
# SUPABASE
# ============================================
# Obtenha em: https://supabase.com/dashboard/ → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# MERCADO PAGO
# ============================================
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# Para testes (Sandbox):
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-your-public-key-here
VITE_MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token-here

# Para produção:
# VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-your-public-key-here
# VITE_MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-access-token-here

# ============================================
# URLs (para produção)
# ============================================
# VITE_APP_URL=https://runbrasil.com.br
# VITE_API_URL=https://api.runbrasil.com.br
