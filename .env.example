# ============================================
# RUNBRASIL - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env.local e preencha os valores

# ============================================
# SUPABASE
# ============================================
# Obtenha em: https://supabase.com/dashboard/ → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# MERCADO PAGO
# ============================================
# ATENÇÃO: O Access Token NÃO vai no frontend (nenhuma variável VITE_* aqui).
# Configure via: supabase secrets set MERCADOPAGO_ACCESS_TOKEN=<token>
# As Edge Functions leem a credencial com Deno.env.get("MERCADOPAGO_ACCESS_TOKEN").

# ============================================
# URLs (para produção)
# ============================================
# VITE_APP_URL=https://runbrasil.com.br
# VITE_API_URL=https://api.runbrasil.com.br
